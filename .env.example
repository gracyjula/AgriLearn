# .env.example — AgriLearn AI
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and replace the placeholder values.
# NEVER commit the .env file to version control.
# NEVER share or publish your real API key.
#
# Steps:
#   1. Get a free API key at: https://aistudio.google.com/app/apikey
#   2. Copy this file:  copy .env.example .env   (Windows)
#   3. Open .env and replace YOUR_API_KEY_HERE with your real key.
# ─────────────────────────────────────────────────────────────────────────────

# Required — your Google AI Studio API key
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Optional — override the default Gemini model name
# Default: gemini-1.5-flash
# GEMINI_MODEL=gemini-1.5-flash

# Optional — model temperature (0.0 = deterministic, 1.0 = creative)
# Default: 0.3 (factual and focused)
# GEMINI_TEMPERATURE=0.3
