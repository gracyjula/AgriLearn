# .env.example — AgriLearn AI
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and replace the placeholder values.
# NEVER commit the .env file to version control.
# NEVER share or publish your real API key.
#
# Steps:
#   1. Get a free API key at: https://aistudio.google.com/app/apikey
#   2. Copy this file:  copy .env.example .env   (Windows)
#   3. Open .env and replace YOUR_API_KEY_HERE with your real key.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Your Google AI Studio API key
GEMINI_API_KEY=YOUR_API_KEY_HERE

# ── Chat model ───────────────────────────────────────────────────────────────

# Gemini chat model name.
# NOTE: gemini-1.5-flash was SHUT DOWN in 2026 and causes a NotFound error.
# Use one of the current stable models below:
#   gemini-3.5-flash  ← recommended (fast, stable)
#   gemini-3.6-flash  ← more capable
#   gemini-3.8-flash  ← most capable
# Default if not set: gemini-3.5-flash
# GEMINI_MODEL=gemini-3.5-flash

# ── Embedding model (for RAG) ─────────────────────────────────────────────────

# Gemini embedding model for RAG document indexing.
# NOTE: text-embedding-004 was SHUT DOWN on January 14, 2026.
# Current stable embedding model: gemini-embedding-001 (supported until May 2028)
# Default if not set: gemini-embedding-001
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Model creativity ──────────────────────────────────────────────────────────

# Temperature: 0.0 = deterministic, 1.0 = creative
# Default: 0.3 (focused, factual responses)
# GEMINI_TEMPERATURE=0.3

# ── RAG (Retrieval-Augmented Generation) ─────────────────────────────────────

# Folder where you place agricultural PDF documents.
# Default: docs/pdfs  (relative to the agrilearn-ai/ folder)
# AGRILEARN_PDF_DIR=docs/pdfs

# Folder where the FAISS vector index is stored.
# Default: docs/vector_store
# AGRILEARN_VECTOR_STORE_DIR=docs/vector_store

# Text chunk size in characters (for splitting PDF pages).
# Default: 800
# AGRILEARN_CHUNK_SIZE=800

# Overlap between consecutive chunks in characters.
# Default: 100
# AGRILEARN_CHUNK_OVERLAP=100

# Number of chunks to retrieve per user question.
# Default: 4
# AGRILEARN_TOP_K=4
